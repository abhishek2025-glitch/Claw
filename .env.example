# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_PAYPAL_CLIENT_ID: Your PayPal Client ID for receiving payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id-here"

# WEBHOOK_SECRET / AGENTSHIELD_SECRET: Secret key required in production for incoming telemetry and policy proposals (Bearer auth)
WEBHOOK_SECRET="your-secure-webhook-secret-here"
AGENTSHIELD_SECRET="your-secure-agentshield-secret-here"

# POLICY_FAILURE_MODE: Enforces fail-closed ("CLOSED") or fail-open ("OPEN") when policy engine encounters errors
POLICY_FAILURE_MODE="CLOSED"

# TELEMETRY_FAILURE_MODE: Controls agent continuation when telemetry backend is unavailable ("OPEN" or "CLOSED")
TELEMETRY_FAILURE_MODE="OPEN"

# WORKSPACE_ROOT: File system boundary for agent operations (defaults to project directory)
WORKSPACE_ROOT="/workspace"

# ALLOWED_DOMAINS: Comma-separated list of approved outbound HTTP destinations
ALLOWED_DOMAINS="google.com,github.com,api.github.com,registry.npmjs.org,pypi.org"

# BLOCKED_DOMAINS: Comma-separated list of prohibited destinations and exfiltration endpoints
BLOCKED_DOMAINS="pastebin.com,ghostbin.com,tempmail.com,ngrok.io,serveo.net"

# EVENT_STORE_DIR: Path to directory where append-only audit JSONL events are persisted
EVENT_STORE_DIR=".agentshield"

# NEXT_PUBLIC_COST_PER_MILLION: Default fallback token cost per 1M tokens (e.g. 0.50)
NEXT_PUBLIC_COST_PER_MILLION="0.50"

# AGENTSHIELD_LICENSE_PUBLIC_KEY: Ed25519 public key (PEM) used by CLI/runtime to verify licenses offline
AGENTSHIELD_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----"

# LICENSE_SIGNING_PRIVATE_KEY: Ed25519 private key (PEM) used by control plane to issue signed licenses (NEVER commit this)
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIE...\n-----END PRIVATE KEY-----"

# DODO_WEBHOOK_SECRET: Secret used to verify incoming Dodo Payments webhooks
DODO_WEBHOOK_SECRET="whsec_dodo_your_secret_here"

# DODO_PAYMENTS_API_KEY: API key for Dodo Payments live checkout sessions
DODO_PAYMENTS_API_KEY="your-dodo-api-key"

# DODO_PAYMENTS_MODE: Set to "test" to allow simulated checkout in development
DODO_PAYMENTS_MODE="test"

# DATABASE_URL: Optional Postgres/Neon/Supabase URL for persistent storage in production
DATABASE_URL="postgres://user:password@host:5432/agentshield"

